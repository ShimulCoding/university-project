# Backend environment variables
# Copy this file to .env before running the backend.

# Application mode
NODE_ENV=development

# Operator-only empty-database setup: default disabled. Enabling binds the
# backend to 127.0.0.1; disable and restart immediately after first-admin setup.
ENABLE_LOCAL_ADMIN_BOOTSTRAP=false

# Express server port
PORT=4000

# Number of trusted reverse-proxy hops; leave 0 for a direct local server
TRUST_PROXY_HOPS=0

# Frontend origin allowed by CORS
# Multiple origins can be separated with commas
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mu_cse_transparency

# Use long random secrets in real environments
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret

# Required separate 32-byte random key encoded as base64; never reuse JWT keys.
# Generate/store through a secrets manager. Do not commit the generated value.
MFA_ENCRYPTION_KEY=

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cookie names
ACCESS_TOKEN_COOKIE_NAME=mu_access_token
REFRESH_TOKEN_COOKIE_NAME=mu_refresh_token

# Password hashing cost
BCRYPT_SALT_ROUNDS=12

# Local upload directory for development
UPLOADS_ROOT=uploads

# Production always requires scanning, regardless of this development flag.
# Configure a private ClamAV daemon first; uploads fail closed on scan failure.
UPLOAD_SCAN_REQUIRED=false
# CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=10000

# Optional seed values for the first system admin
SEED_ADMIN_FULL_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Local-only demo creation, never a credential-reset tool. Supply a private
# password (16+ characters, at most 72 UTF-8 bytes); historic defaults are denied.
ENABLE_LOCAL_DEMO_SEED=false
SEED_DEMO_PASSWORD=

# Optional real SMTP transport (required for production password recovery)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# STARTTLS is mandatory when false; implicit TLS (usually port 465) uses true.
# Certificate verification cannot be disabled. Never use a plaintext relay.
# SMTP_USER=replace-with-smtp-user
# SMTP_PASS=replace-with-smtp-password
# SMTP_FROM="MU CSE Transparency <noreply@example.com>"
