# Frontend environment variables
# Copy this file to .env.local before running the frontend.

# Backend API base URL used by the Next.js app
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# If backend cookie names are customized, set the same names here for SSR recovery
# ACCESS_TOKEN_COOKIE_NAME=mu_access_token
# REFRESH_TOKEN_COOKIE_NAME=mu_refresh_token
